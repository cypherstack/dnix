+        } else if arg.starts_with("-Wl,")
+            && (arg.ends_with("/list.def") || arg.ends_with("\\list.def"))
+        {
+            // rustc's export list; zig takes a module definition file as an
+            // input rather than as a linker argument.
+            return FilteredArg::Keep(vec![arg["-Wl,".len()..].to_string()]);
